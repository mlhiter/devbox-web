FROM --platform=$BUILDPLATFORM scratch
ARG TARGETARCH

COPY registry_${TARGETARCH} registry
COPY install.sh install.sh
COPY devbox-v2-frontend-values.yaml devbox-v2-frontend-values.yaml
COPY charts charts

ENV cloudDomain="127.0.0.1.nip.io"
ENV cloudPort=""
ENV certSecretName="wildcard-cert"
ENV registryAddr="hub.dev.sealos.plus"
ENV registryUser=""
ENV registryPassword=""

CMD ["bash install.sh"]
